HOST=127.0.0.1
PORT=5173
DEMO_ADMIN=1
# DATABASE_PATH=.runtime/forme.sqlite
# COOKIE_SECURE=1
# PUBLIC_ORIGIN=https://your-demo.example

# Optional Stylist narration. Catalog search and filtering work without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional virtual try-on. Set categories only after confirming image quality.
FASHN_API_KEY=
TRYON_AI_CATEGORIES=
# Valid values: tops,bottoms,dresses

# Optional Face Swap. Enable only after a test with a consented portrait.
REPLICATE_API_TOKEN=
FACE_SWAP_ENABLED=0
AI_DAILY_LIMIT=15
